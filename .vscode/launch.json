{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "분석 파이프라인 실행",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "참고용 데이터 재생성 후 실행 (--regen)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "args": ["--regen"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
